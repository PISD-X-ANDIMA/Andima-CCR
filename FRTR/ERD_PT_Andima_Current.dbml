  description text [not null]
  proof_photo_url text
  reported_by uuid
  created_at timestamptz
}

Table tracking_login {
  id uuid [pk]
  auth_user_id uuid [not null] [note: 'Logical relation inferred from column name; confirm physical FK.']
  employee_id uuid [not null] [note: 'Logical relation inferred from column name; confirm physical FK.']
  date date [not null]
  timelogin time [not null]
  timelogout time
  email text [not null]
  role text [not null]
  created_at timestamptz [not null]
}

Table c2_cost_transactions {
  id uuid [pk]
  job_number varchar [not null]
  customer_name varchar [not null]
  branch_code varchar
  cost_category varchar [not null]
  period_month varchar
  planned_cost numeric
  actual_cost numeric
  variance numeric
  has_evidence bool
  evidence_url text
  reconciliation_result varchar
  review_flag bool
  exception_tags _text
  voucher_no varchar
  description text
  created_at timestamptz
  updated_at timestamptz
}

