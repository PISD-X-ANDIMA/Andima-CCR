# Supabase configuration is used only by server-side modules.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Administrative operations and registration provisioning. Never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Existing NEXT_PUBLIC_SUPABASE_* configuration remains supported on the server.
